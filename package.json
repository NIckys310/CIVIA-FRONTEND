{
  "name": "civia",
  "private": true,
  "description": "CIVIA AI — el copiloto digital del ingeniero civil",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:sync": "node scripts/sync-contract.mjs",
    "audit:prod": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~7.0"
  },
  "overrides": {
    "react-native": "0.86.3",
    "uuid": "11.1.1"
  }
}
