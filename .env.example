# Copia a apps/web/.env.local (web) o define en eas.json (móvil). Nunca commitees .env*.

# Web: backend al que Next.js reenvía /api/v1/* (mismo dominio, sin CORS).
# Local: la API de CIVIA-BACKEND. Vercel: la URL de Render.
API_PROXY_TARGET=http://localhost:8000

# App móvil: el emulador de Android alcanza el PC en 10.0.2.2
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
