{
  "expo": {
    "name": "CIVIA",
    "slug": "civia",
    "scheme": "civia",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A111D",
    "ios": {
      "bundleIdentifier": "co.civia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "CIVIA usa Face ID para desbloquear tu sesión de forma segura.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.civia.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CIVIA usa Face ID para desbloquear tu sesión de forma segura."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
