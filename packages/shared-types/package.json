{
  "name": "@civia/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos TypeScript generados desde el contrato OpenAPI de la API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@civia/tsconfig": "*",
    "openapi-typescript": "^7.13.0"
  }
}
